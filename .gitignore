# Python bytecode caches. Note these DO embed absolute source paths, so they must
# never be committed even though they look like harmless build output.
__pycache__/
*.py[cod]

# Verification output — regenerated by tests/verify_all.py
tests/artifacts/

# Optional per-machine override for the MCP server's script locations. The server
# normally self-locates from its own path; this file is only for the case where
# the bundle lives outside the workspace it serves.
dsh-uefi-mcp/_paths.local.json
